{
	"name": "@earendil-works/pi-coding-agent",
	"version": "1.6.0",
	"description": "Coding agent SDK with session management, tools, and Pi extensions",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./host-support/*": {
			"types": "./dist/*.d.ts",
			"import": "./dist/*.js"
		}
	},
	"files": [
		"dist",
		"docs/codemode.md",
		"docs/compaction.md",
		"docs/custom-provider.md",
		"docs/environment-variables.md",
		"docs/extensions.md",
		"docs/mcp.md",
		"docs/message-types.md",
		"docs/models*.md",
		"docs/packages.md",
		"docs/prompt-templates.md",
		"docs/providers.md",
		"docs/sdk-api.md",
		"docs/sdk.md",
		"docs/security.md",
		"docs/session-format.md",
		"docs/settings.md",
		"docs/skills.md",
		"docs/virtual-models.md",
		"examples/sdk",
		"examples/extensions/hello.ts",
		"schemas",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"generate:schemas": "node --import ./src/experimental/source-resolver.ts scripts/generate-schemas.ts",
		"generate:references": "node --import ./src/experimental/source-resolver.ts scripts/generate-references.ts",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "1.6.0",
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-codemode": "1.6.0",
		"@earendil-works/pi-mcp": "1.6.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"brace-expansion": "5.0.12",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "11.0.3",
		"proper-lockfile": "4.1.2",
		"quickjs-wasi": "3.6.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.12.4",
		"yaml": "2.9.0"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"vitest": "4.1.12"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/earendil-works/pi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
